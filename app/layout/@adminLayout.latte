{layout '@baseLayout.latte'}

{define #bodyContent}
	<div class="app">
		<header class="app-topbar">
			<button type="button" class="app-menu-toggle" data-menu-toggle aria-label="Menu" aria-controls="appSidebar" aria-expanded="false">
				<span></span>
			</button>

			<a class="app-brand" n:href=":Admin:Admin:">
				<img src="{$basePath}/images/icon_ball.gif" alt="" width="22" height="22">
				Volejbálek
			</a>

			<nav class="app-topbar-actions">
				<a n:href=":Public:Public:">Docházka</a>
				<a n:href="logout!">Odhlásit <span class="app-topbar-user">{$user->getIdentity()->login ?? ''}</span></a>
			</nav>
		</header>

		<nav id="appSidebar" class="app-sidebar" data-menu>
			<div class="app-nav">
				<a n:href=":Admin:Term:" class={[is-active => $presenter->isLinkCurrent(':Admin:Term:*')]}>
					<span class="fa-solid fa-calendar fa-fw"></span>
					Termíny
				</a>
				<a n:href=":Admin:Player:" class={[is-active => $presenter->isLinkCurrent(':Admin:Player:*')]}>
					<span class="fa-solid fa-user fa-fw"></span>
					Hráči
				</a>
				<a n:href=":Admin:Team:" class={[is-active => $presenter->isLinkCurrent(':Admin:Team:*')]}>
					<span class="fa-solid fa-users fa-fw"></span>
					Týmy
				</a>
				<a n:href=":Admin:Message:" class={[is-active => $presenter->isLinkCurrent(':Admin:Message:*')]}>
					<span class="fa-solid fa-comments fa-fw"></span>
					Zprávy
				</a>
				<a n:href=":User:User:" class={[is-active => $presenter->isLinkCurrent(':User:User:*')]}>
					<span class="fa-solid fa-user-shield fa-fw"></span>
					Uživatelé
				</a>
			</div>
		</nav>

		<main class="app-main">
			<div class="page-head">
				<h1 class="page-title">{ifset #header}{include #header}{/ifset}</h1>
				{ifset #toolbox}
					<div class="page-actions">{include #toolbox}</div>
				{/ifset}
			</div>

			{include content}
		</main>
	</div>
{/define}
