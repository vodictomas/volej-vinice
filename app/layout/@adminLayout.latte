{layout '@baseLayout.latte'}

{define #bodyContent}
	<header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
		<a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" n:href=":Admin:Admin:">
			Volejbálek
		</a>
		<div class="navbar-nav">
			<div class="nav-item text-nowrap">
				<a class="nav-link px-3" href="#">
					Odhlásit
				</a>
			</div>
		</div>
	</header>

	<div class="container-fluid">
		<div class="row">
			<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
				<div class="position-sticky pt-3">
					<ul class="nav flex-column">
						<li class="nav-item">
							<a class="nav-link active" aria-current="page" n:href=":Admin:Term:">
								{icon calendar}
								Termíny
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link active" aria-current="page" n:href=":Admin:Player:">
								{icon user}
								Hráči
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link active" aria-current="page" n:href=":Admin:Team:">
								{icon users}
								Týmy
							</a>
						</li>
					</ul>
				</div>
			</nav>
			<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
				<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
					<h1 class="h2">{ifset header}{include header}{/ifset}</h1>
					{ifset toolbox}
						<div class="btn-toolbar mb-2 mb-md-0">
							{include toolbox}
						</div>
					{/ifset}
				</div>
				{include content}
			</main>
		</div>
	</div>
{/define}