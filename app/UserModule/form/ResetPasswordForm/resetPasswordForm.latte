<form n:name="form" class="login-card">
	<div class="login-brand">
		<img src="{$basePath}/images/icon_ball.gif" alt="" width="24" height="24">
		Volejbálek
	</div>

	<h1>Obnovení hesla</h1>

	<div n:foreach="$form->getOwnErrors() as $error" class="alert alert-danger">{$error}</div>

	<p class="text-muted">{label email /}</p>

	<div class="mb-3">
		<input n:name="email">
		<div n:ifcontent class="invalid-feedback">{inputError email}</div>
	</div>

	<div class="d-grid gap-1">
		<input n:name="reset" class="btn btn-primary">
		<a href="{plink :User:Login:}" class="btn btn-link">Zpět na přihlášení</a>
	</div>
</form>
