<form n:name="form" class="login-card">
	<h3 class="mb-4">Nastavení nového hesla</h3>

	<div class="mb-3">
		<input n:name="password">
		<div n:ifcontent class="invalid-feedback">{inputError password}</div>
	</div>

	<div class="mb-3">
		<input n:name="password_confirm">
		<div n:ifcontent class="invalid-feedback">{inputError password_confirm}</div>
	</div>

	<div class="d-grid gap-2">
		<input n:name="save" class="btn btn-primary">
		<a href="{plink :User:Login:}" class="btn btn-link">Zpět na přihlášení</a>
	</div>
</form>
